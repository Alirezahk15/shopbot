# /etc/systemd/system/shopbot-panel.service
#
# IMPORTANT: --workers must stay at 1.
# The login rate limiter keeps its attempt table in process memory, so a
# second worker would give an attacker twice the allowed attempts.
[Unit]
Description=Shop Bot Admin Panel (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=shopbot
Group=shopbot
WorkingDirectory=/opt/shopbot
EnvironmentFile=/opt/shopbot/.env
ExecStart=/opt/shopbot/venv/bin/python -m uvicorn api.main:app \
    --host 127.0.0.1 --port 8000 --workers 1 --proxy-headers
Restart=always
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/shopbot

StandardOutput=journal
StandardError=journal
SyslogIdentifier=shopbot-panel

[Install]
WantedBy=multi-user.target
