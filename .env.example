# ═══ ShopBot — نمونه تنظیمات ═══
# این فایل را با نام .env کپی کنید و مقادیر را پر کنید:
#   Windows:  copy .env.example .env
#   Linux:    cp .env.example .env

# ── ربات تلگرام (الزامی) — از @BotFather ──
BOT_TOKEN=

# ── پنل مدیریت وب (الزامی) ──
PANEL_PASSWORD=
JWT_SECRET=
PANEL_PORT=8000
# PANEL_CORS_ORIGINS=http://localhost:3000

# ══════════════════════════════════════════════════════════
# موارد زیر همگی «اختیاری» هستند.
# خالی گذاشتن آنها باعث خطا یا توقف ربات نمی‌شود — فقط همان
# روش پرداخت غیرفعال می‌ماند تا وقتی مقدارش را پر کنید.
# ══════════════════════════════════════════════════════════

# ── USDT شبکه BEP20 (اختیاری) ──
# فقط اگر پرداخت با USDT را فعال کرده‌اید لازم است.
# کلید رایگان از https://bscscan.com/myapikey
BSCSCAN_API_KEY=

# ── نرخ دلار navasan.tech (اختیاری) ──
# مقدار پیش‌فرض free است و برای اکثر کاربران کافی است.
USD_RATE_API_KEY=free

# ── زرین‌پال (اختیاری) ──
# فقط اگر درگاه زرین‌پال را فعال کرده‌اید لازم است.
ZARINPAL_MERCHANT_ID=
