# ═══ ShopBot — نمونه تنظیمات ═══
# این فایل را با نام .env کپی کنید و مقادیر را پر کنید:
#   Windows:  copy .env.example .env
#   Linux:    cp .env.example .env

# ── ربات تلگرام (الزامی) — از @BotFather ──
BOT_TOKEN=

# ── پنل مدیریت وب (الزامی) ──
# PANEL_PASSWORD فقط برای اولین ورود استفاده می‌شود. اگر خالی بماند،
# ورود با رمز ساده کاملاً غیرفعال می‌شود (امن‌تر).
PANEL_PASSWORD=

# JWT_SECRET الزامی است و باید حداقل ۳۲ کاراکتر باشد.
# پنل با مقدار خالی یا پیش‌فرض بالا نمی‌آید. ساخت مقدار تصادفی:
#   python3 -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=

PANEL_PORT=8000
# PANEL_CORS_ORIGINS=http://localhost:3000

# اگر پنل پشت nginx است (حالت عادی) روی 1 بماند تا IP واقعی
# کاربر از X-Forwarded-For خوانده شود. اگر مستقیم بدون پراکسی
# اجرا می‌کنید روی 0 بگذارید.
PANEL_TRUST_PROXY=1

# مسیر فایل دیتابیس (اختیاری). پیش‌فرض shop.db کنار کد است.
# SHOPBOT_DB=/opt/shopbot/shop.db

# ══════════════════════════════════════════════════════════
# موارد زیر همگی «اختیاری» هستند.
# خالی گذاشتن آنها باعث خطا یا توقف ربات نمی‌شود — فقط همان
# روش پرداخت غیرفعال می‌ماند تا وقتی مقدارش را پر کنید.
# ══════════════════════════════════════════════════════════

# ── USDT شبکه BEP20 (اختیاری) ──
# فقط اگر پرداخت با USDT را فعال کرده‌اید لازم است.
# کلید رایگان از https://bscscan.com/myapikey
BSCSCAN_API_KEY=

# ── نرخ دلار navasan.tech (اختیاری) ──
# مقدار پیش‌فرض free است و برای اکثر کاربران کافی است.
USD_RATE_API_KEY=free

# ── زرین‌پال (اختیاری) ──
# فقط اگر درگاه زرین‌پال را فعال کرده‌اید لازم است.
ZARINPAL_MERCHANT_ID=

# ── مقادیر اختصاصی فروشگاه (اختیاری) ──
# قبلاً این‌ها داخل config.py هاردکد بودند. خالی بگذارید تا مقدار
# پیش‌فرض قبلی استفاده شود.
# آیدی عددی ادمین‌ها — با کاما جدا کنید
# ADMIN_IDS=1663320676
# SUPPORT_USERNAME=@akhit77
# USDT_WALLET=0x...
