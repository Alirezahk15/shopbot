# ═══ ShopBot — نمونه تنظیمات ═══
# این فایل را با نام .env کپی کنید و مقادیر را پر کنید:
#   Windows:  copy .env.example .env
#   Linux:    cp .env.example .env

# ── ربات تلگرام (الزامی) — از @BotFather ──
BOT_TOKEN=

# ── پنل مدیریت وب (الزامی) ──
PANEL_PASSWORD=
JWT_SECRET=
PANEL_PORT=8000
# PANEL_CORS_ORIGINS=http://localhost:3000

# ── API های پرداخت (الزامی برای اجرای ربات) ──
BSCSCAN_API_KEY=
USD_RATE_API_KEY=free

# ── زرین‌پال (اختیاری) ──
# ZARINPAL_MERCHANT_ID=
